# Copy to .env. Keep this file and all real credentials on the server.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
EZRA_DATA_DIR=./data
# Optional for localhost; required before exposing the app beyond your machine.
EZRA_ACCESS_TOKEN=
EZRA_INFERENCE_TIMEOUT=120
EZRA_MAX_OUTPUT_TOKENS=2048
# A character budget for recent COMPLETE turns, not a model-specific token limit.
EZRA_CONTEXT_CHARACTERS=24000
# Optional cloud mode: configure all fields together on Render, not in Git.
# EZRA_DATABASE_URL=postgresql://...
# EZRA_DATABASE_PASSWORD=
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=ezra-private
